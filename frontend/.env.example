# Copy this to .env and fill in your Supabase project's values.
# Settings -> API in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: RevenueCat public SDK key (iOS), from the RevenueCat dashboard ->
# Project settings -> API keys. Leave unset and the app never shows the
# paywall (useful for local dev before RevenueCat is fully configured).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
